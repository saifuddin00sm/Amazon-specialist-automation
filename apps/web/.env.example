# Copy to .env.local.
#
# mock (default): the in-memory dataset, acting as each workspace's owner, no sign-in.
# supabase: the database below; members sign in with a magic link and row-level security applies.
DATA_SOURCE=mock

# Needed with DATA_SOURCE=supabase. For the local stack (`pnpm db:start`, then `pnpm db:seed`),
# take API_URL and PUBLISHABLE_KEY from `pnpm exec supabase status`. Magic-link emails land in
# Mailpit at http://127.0.0.1:55324.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=

# Background work (Inngest functions, served at /api/inngest) acts as the backend, not a member.
# With DATA_SOURCE=supabase it needs the secret key: SECRET_KEY from `pnpm exec supabase status`.
SUPABASE_SECRET_KEY=

# The nightly catalog sync reads Amazon for every account connected with `pnpm amazon:connect-seller`.
# Same values as packages/workflows/.env.local; the encryption key must match or tokens won't open.
AMAZON_ENV=production
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_TOKEN_ENCRYPTION_KEY=

# Locally, run the Inngest dev server (`pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest`)
# and set INNGEST_DEV=1. Deployed, set INNGEST_SIGNING_KEY and INNGEST_EVENT_KEY from Inngest Cloud instead.
INNGEST_DEV=1
