# Copy to .env.local.
#
# mock (default): the in-memory dataset, acting as each workspace's owner, no sign-in.
# supabase: the database below; members sign in with a magic link and row-level security applies.
DATA_SOURCE=mock

# Needed with DATA_SOURCE=supabase. For the local stack (`pnpm db:start`, then `pnpm db:seed`),
# take API_URL and PUBLISHABLE_KEY from `pnpm exec supabase status`. Magic-link emails land in
# Mailpit at http://127.0.0.1:55324.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
