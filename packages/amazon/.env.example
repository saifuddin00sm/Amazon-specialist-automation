# Copy to .env.local (git-ignored). Read by the sandbox tests; the app sets these in its own env.

# Sandbox unless set to production.
AMAZON_ENV=sandbox

# The LWA client of your SP-API app (Seller Central > Develop Apps > View credentials).
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=

# A refresh token from self-authorizing that app (Develop Apps > Authorize). Sandbox tests only;
# real sellers' refresh tokens are sealed into the token store, never kept in env.
AMAZON_SANDBOX_REFRESH_TOKEN=

# 32 random bytes, base64, sealing refresh tokens at rest. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AMAZON_TOKEN_ENCRYPTION_KEY=
