# Copy to .env.local (git-ignored). Read by `pnpm amazon:connect-seller`. The web app sets the same
# AMAZON_* and SUPABASE_* variables in its own env for the Inngest functions.

# Your own listings need production: the sandbox only answers Amazon's canned examples. A
# self-authorized app may call production for the seller that authorized it.
AMAZON_ENV=production

# The LWA client of your SP-API app (Seller Central > Develop Apps > View credentials).
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=

# 32 random bytes, base64, sealing refresh tokens at rest. Must be the web app's key too: a token
# sealed with one key opens only with it.
AMAZON_TOKEN_ENCRYPTION_KEY=

# The test seller: its merchant token (Seller Central > Settings > Account Info > Merchant Token)
# and the refresh token from self-authorizing the app (Develop Apps > Authorize). The script seals
# the refresh token into Supabase; once the account is connected you can clear it here.
AMAZON_SELLER_ID=
AMAZON_SELLER_REFRESH_TOKEN=

# The Supabase project to write to. For the local stack, API_URL and SECRET_KEY from
# `pnpm exec supabase status`.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=
