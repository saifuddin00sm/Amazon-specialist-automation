{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {
      "outputs": []
    },
    "test:e2e": {
      "cache": false
    },
    "@app/data#test": {
      "outputs": [],
      "cache": false
    },
    "@app/amazon#test": {
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["AMAZON_*"]
    }
  }
}
